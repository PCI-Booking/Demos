{
  "name": "pci-booking-tests",
  "version": "1.0.0",
  "description": "Automated test suite for PCI Booking card capture integration",
  "main": "test-runner.js",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:interactive": "npx playwright test interactive-fill --headed --project=chromium",
    "test:ui": "npx playwright test --ui",
    "test:puppeteer": "node test-runner.js",
    "test:puppeteer:headed": "node test-runner.js --headed",
    "codegen": "npx playwright codegen"
  },
  "keywords": ["pci-booking", "payment", "testing", "automation", "playwright"],
  "license": "MIT",
  "dependencies": {
    "puppeteer": "^21.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
